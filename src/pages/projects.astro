---
import Base from '../layouts/Base.astro';
import { Icon } from 'astro-icon/components';
import EmptyState from '../components/EmptyState.astro';
import { projects } from '../data/projects';
---

<Base
  title="Projects | LZ-Team"
  activeNav="projects"
>
  <section class="container page-hero">
    <p class="eyebrow">ls ./projects</p>
    <h1 class="hero-title"><span class="gradient-text">Projects</span></h1>
  </section>

  <section class="container section-tight">
    {
      projects.length === 0 ? (
        <EmptyState
          text="暂时没有项目"
        />
      ) : (
        <div class="project-grid">
          {
            projects.map((project) => (
              <a
                class="project-card"
                href={project.href}
                target={project.external ? '_blank' : undefined}
                rel={project.external ? 'noopener noreferrer' : undefined}
              >
                <div class="project-icon" aria-hidden="true"><Icon name={project.icon} /></div>
                <div class="project-body">
                  <h3 class="project-title">{project.title}</h3>
                  <p class="project-desc">{project.description}</p>
                  <div class="project-tags">
                    {project.tags.map((tag) => <span class="tag">#{tag}</span>)}
                  </div>
                </div>
                <span class="project-arrow" aria-hidden="true"><Icon name="ph:arrow-up-right" /></span>
              </a>
            ))
          }
        </div>
      )
    }
  </section>
</Base>
