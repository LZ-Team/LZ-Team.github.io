---
import { Image } from 'astro:assets';
import logo from '../assets/lz-logo.png';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <Image src={logo} alt="LZ-Team" width={30} height={30} />
      <span>LZ-Team</span>
    </div>

    <p class="footer-copy">
      &copy; {year} LZ-Team · <code>cat /flag</code> · <code>nc -lvnp lz</code>
    </p>
  </div>
</footer>
